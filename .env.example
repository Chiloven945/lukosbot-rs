# Copy to `.env` for local development. Never commit real credentials.
#
# Configuration precedence:
#   CLI flags > environment > TOML file > built-in defaults
#
# Nested configuration keys use `__` as the separator.

# LUKOSBOT_CONFIG=config/application.toml
# LUKOSBOT_LOG=info,sqlx=warn

# Platform credentials (prefer environment variables over the TOML file)
# LUKOSBOT__PLATFORMS__TELEGRAM__TOKEN=123456:replace-me
# LUKOSBOT__PLATFORMS__DISCORD__TOKEN=replace-me

# Third-party integrations
# LUKOSBOT__INTEGRATIONS__GITHUB__TOKEN=
# LUKOSBOT__INTEGRATIONS__MUSIC__SPOTIFY__CLIENT_ID=
# LUKOSBOT__INTEGRATIONS__MUSIC__SPOTIFY__CLIENT_SECRET=
# LUKOSBOT__INTEGRATIONS__MUSIC__SOUNDCLOUD__CLIENT_ID=
# GITHUB_TOKEN is read only when LUKOSBOT__INTEGRATIONS__GITHUB__TOKEN is unset.
